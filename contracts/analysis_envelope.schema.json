{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsc:0.3:analysis_envelope",
  "title": "analysis_envelope",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "const": "TRUSTED_APPLICATION"
    },
    "provider_type": {
      "enum": [
        "MOCK",
        "QWEN_HTTP",
        "OTHER_EXPLICITLY_APPROVED"
      ]
    },
    "model_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "case_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "NEEDS_INPUT",
        "FAILED",
        "CANCELLED"
      ]
    },
    "retrieval_status": {
      "enum": [
        "NOT_REQUESTED",
        "COMPLETE",
        "INCOMPLETE",
        "FAILED"
      ]
    },
    "retrieval_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "0.3"
            },
            "intent": {
              "enum": [
                "EDUCATION",
                "DOCUMENT_ANALYSIS",
                "CASE_DIAGNOSIS",
                "PLAN_ASSESSMENT",
                "INVENTORY_ASSESSMENT"
              ]
            },
            "module_ids": {
              "type": "array",
              "items": {
                "enum": [
                  "M01",
                  "M02",
                  "M03",
                  "M04",
                  "M05",
                  "M06",
                  "M07",
                  "M08",
                  "M09"
                ]
              },
              "uniqueItems": true
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "PHYS_CHEM",
                  "ENGINEERING",
                  "GOVERNANCE"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "scope": {
              "type": "object",
              "properties": {
                "scope_class": {
                  "enum": [
                    "C1",
                    "C2",
                    "C3",
                    "C4",
                    "UNDETERMINED",
                    "NOT_APPLICABLE"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "search_run_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deviations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence_sufficiency": {
                  "enum": [
                    "SUFFICIENT_FOR_TASK",
                    "PARTIAL",
                    "INSUFFICIENT"
                  ]
                }
              },
              "required": [
                "scope_class",
                "rationale",
                "search_run_refs",
                "deviations",
                "evidence_sufficiency"
              ],
              "additionalProperties": false
            },
            "urgency_assessment": {
              "enum": [
                "ROUTINE",
                "ATTENTION",
                "URGENT",
                "UNKNOWN"
              ]
            },
            "answer_markdown": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "enum": [
                      "REPORTED",
                      "OBSERVED",
                      "MEASURED",
                      "DOCUMENTED",
                      "DERIVED",
                      "HYPOTHESIS",
                      "MODEL_KNOWLEDGE",
                      "PROVIDED_ASSUMPTION"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "string",
                          "minLength": 1
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "revision",
                        "locator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "claim_id",
                  "text",
                  "basis",
                  "evidence_refs",
                  "assumptions"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "basis": {
                          "const": "DOCUMENTED"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "evidence_refs": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "hypotheses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hypothesis_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supporting_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "contradicting_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "unresolved_factors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "hypothesis_id",
                  "explanation",
                  "supporting_refs",
                  "contradicting_refs",
                  "unresolved_factors"
                ],
                "additionalProperties": false
              }
            },
            "predictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "prediction_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "enum": [
                      "SCENARIO_REASONING",
                      "BOUNDED_CALCULATION",
                      "VALIDATED_PREDICTOR"
                    ]
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "horizon": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "input_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "result_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "probability": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "validation_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "uncertainty": {
                    "type": "string",
                    "minLength": 1
                  },
                  "invalidating_conditions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "prediction_id",
                  "level",
                  "target",
                  "horizon",
                  "method_ref",
                  "input_refs",
                  "assumptions",
                  "result_text",
                  "probability",
                  "validation_ref",
                  "uncertainty",
                  "invalidating_conditions"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "probability": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "probability"
                      ]
                    },
                    "then": {
                      "properties": {
                        "level": {
                          "const": "VALIDATED_PREDICTOR"
                        },
                        "method_ref": {
                          "type": "string",
                          "minLength": 1
                        },
                        "validation_ref": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "recommendation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "MATCHED_GUIDANCE",
                      "ADAPTED_PLAN",
                      "HYPOTHESIS_PLAN"
                    ]
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "string",
                          "minLength": 1
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "revision",
                        "locator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "intended_actor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_needed": {
                    "type": "boolean"
                  },
                  "residual_uncertainty": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reevaluation_triggers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "recommendation_id",
                  "kind",
                  "purpose",
                  "text",
                  "evidence_refs",
                  "assumptions",
                  "preconditions",
                  "intended_actor",
                  "review_needed",
                  "residual_uncertainty",
                  "reevaluation_triggers"
                ],
                "additionalProperties": false
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "schema_version",
            "intent",
            "module_ids",
            "capabilities",
            "scope",
            "urgency_assessment",
            "answer_markdown",
            "claims",
            "hypotheses",
            "predictions",
            "recommendations",
            "questions",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "execution_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "UNKNOWN",
              "CANCELLED",
              "NOT_AVAILABLE"
            ]
          },
          "output": {},
          "units": {
            "type": "object"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "execution_id",
          "tool_id",
          "tool_version",
          "input_hash",
          "status",
          "output",
          "units",
          "assumptions",
          "warnings",
          "started_at",
          "finished_at",
          "is_synthetic"
        ],
        "additionalProperties": false
      }
    },
    "validation_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "is_demo": {
      "type": "boolean"
    },
    "external_business_actions_enabled": {
      "const": false
    },
    "actual_business_receipts": {
      "type": "array",
      "maxItems": 0
    },
    "saved_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "generated_by",
    "provider_type",
    "model_profile_id",
    "case_revision",
    "status",
    "retrieval_status",
    "retrieval_snapshot_id",
    "proposal",
    "tool_executions",
    "validation_issues",
    "is_demo",
    "external_business_actions_enabled",
    "actual_business_receipts",
    "saved_at"
  ],
  "additionalProperties": false
}
